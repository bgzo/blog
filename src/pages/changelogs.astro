---
import { getEntry, render } from 'astro:content';
import Post from '../layouts/Post.astro';

const entry = await getEntry('pages', 'changelogs');
if (!entry) throw new Error('Missing changelogs page entry');
const { Content, headings } = await render(entry);
const postEntry = { ...entry, url: '/changelogs.html', section: '' };
---

<Post entry={postEntry} headings={headings} contentHtml={entry.rendered.html}>
  <Content />
</Post>
