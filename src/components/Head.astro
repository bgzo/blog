---
import GoogleAnalytics from './GoogleAnalytics.astro';
import { canonical, withBase } from '../lib/url';
import { formatIsoLocal } from '../lib/dates';

const {
  title,
  description,
  pagePath,
  type = 'website',
  published,
} = Astro.props;

const siteDescription = '分享我的好运，偏见与无知';
const rawDescription = description || siteDescription;
const chars = Array.from(rawDescription);
const seoDescription =
  chars.length > 200 ? `${chars.slice(0, 200).join('')}…` : rawDescription;
const pageUrl = canonical(pagePath);
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title set:html={`${title} - bGZo's blog`} />
<link rel="apple-touch-icon" sizes="180x180" href={withBase('/assets/favicons/apple-touch-icon.png')} />
<link rel="icon" type="image/png" sizes="32x32" href={withBase('/assets/favicons/favicon-32x32.png')} />
<link rel="icon" type="image/png" sizes="16x16" href={withBase('/assets/favicons/favicon-16x16.png')} />
<link rel="manifest" href={withBase('/assets/favicons/site.webmanifest')} />
<link rel="mask-icon" href={withBase('/assets/favicons/safari-pinned-tab.svg')} color="#5bbad5" />
<meta name="msapplication-TileColor" content="#da532c" />
<meta name="theme-color" content="#ffffff" />
<link href={withBase('/assets/css/custom.css')} rel="stylesheet" />
<link type="application/atom+xml" rel="alternate" href={canonical('/feed.xml')} title="bGZo's blog" />
<link rel="canonical" href={pageUrl} />
<meta name="description" content={seoDescription} />
<meta property="og:title" content={title} />
<meta property="og:description" content={seoDescription} />
<meta property="og:url" content={pageUrl} />
<meta property="og:site_name" content="bGZo’s blog" />
<meta property="og:type" content={type} />
{published && (
  <meta property="article:published_time" content={`${formatIsoLocal(published)}+00:00`} />
)}
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={seoDescription} />
<GoogleAnalytics />
