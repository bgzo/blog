---
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import PostMeta from '../components/PostMeta.astro';
import Toc from '../components/Toc.astro';
import MathJax from '../components/MathJax.astro';
import SourceFooter from '../components/SourceFooter.astro';
import BackToTop from '../components/BackToTop.astro';

const { entry, headings, contentHtml } = Astro.props;
const { title, published, modified, description } = entry.data;
---

<!doctype html>
<html lang="en">
  <head>
    <Head
      title={title}
      description={description}
      pagePath={entry.url}
      type="article"
      published={published}
    />
  </head>
  <body class="single-post">
    <Header section={entry.section} pagePath={entry.url} />
    <main>
      <article>
        <h2>{title}</h2>
        <PostMeta
          published={published ?? entry.data.created}
          modified={modified}
          contentHtml={contentHtml}
        />
        <blockquote class="callout callout-warning archive-notice">
          <p class="callout-title" aria-label="Notice">
            <span class="callout-icon">
              <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                <path
                  d="M6.457 1.047c.659-1.234 2.427-1.234 3.086 0l6.082 11.378A1.75 1.75 0 0 1 14.082 15H1.918a1.75 1.75 0 0 1-1.543-2.575Zm1.763.707a.25.25 0 0 0-.44 0L1.698 13.132a.25.25 0 0 0 .22.368h12.164a.25.25 0 0 0 .22-.368Zm.53 3.996v2.5a.75.75 0 0 1-1.5 0v-2.5a.75.75 0 0 1 1.5 0ZM9 11a1 1 0 1 1-2 0 1 1 0 0 1 2 0Z"
                />
              </svg>
            </span>
            &nbsp;Notice / 说明
          </p>
          <p>
            This page is a historical snapshot preserved for archival purposes
            only. It is no longer maintained, and we take no responsibility for
            its content. This page exists solely to reduce dead links on the
            internet.
            <br />
            <em>
              本页面为历史快照，仅供存档备份，不再更新，亦不对其内容负责。保留此页面的唯一目的是减少互联网死链。
            </em>
          </p>
        </blockquote>
        <Toc headings={headings} contentHtml={contentHtml} />
        <slot />
      </article>
    </main>
    <MathJax />
    <script>
      import '../scripts/embed.js';
    </script>
    <!-- Add linkify script to enhance URLs in the content -->
    <script>
      import '../scripts/linkify.js';
    </script>
    <!-- Transform GFM-style callouts: > [!NOTE], > [!TIP], > [!WARNING], > [!IMPORTANT], > [!CAUTION] -->
    <script>
      import '../scripts/callout.js';
    </script>
    <script>
      import '../scripts/back-to-top.js';
    </script>
    <BackToTop />
    <SourceFooter />
  </body>
</html>
