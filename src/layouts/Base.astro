---
const { title, bodyClass } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} - bGZo's blog</title>
  </head>
  <body class={bodyClass}>
    <slot />
  </body>
</html>
